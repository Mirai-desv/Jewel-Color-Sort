  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue_05
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Gianne
    portrait: {fileID: 21300000, guid: 8bae822cdd5f8749aeaf278f4b53b2ac, type: 3}
    background: {fileID: 0}
    text: "C\u1EA3 ng\xE0y ng\u1EEDi to\xE0n m\xF9i h\xF3a ch\u1EA5t t\u1EA9y r\u1EEDa
      v\u1EDBi l\u1EA1i \u0111\u1EE9ng c\u1EA1nh c\xE1i l\xF2 s\u1EA5y n\xF3ng h\u1EA7m
      h\u1EADp, gi\u1EDD mi\u1EC7ng t\xF4i \u0111\u1EAFng ng\u1EAFt, ch\u1EB3ng c\xF2n
      th\u1EA5y t\xFD v\u1ECB gi\xE1c n\xE0o n\u1EEFa. Nh\xECn \u0111\u1ED3 \u0103n
      m\xE0 ch\u1EC9 th\u1EA5y ch\xE1n ng\xE1n..."
  - speakerName: Ichira
    portrait: {fileID: 21300000, guid: 8bae822cdd5f8749aeaf278f4b53b2ac, type: 3}
    background: {fileID: 0}
    text: "Th\u1EA3o n\xE0o tr\xF4ng ch\u1ECB m\u1EC7t m\u1ECFi th\u1EBF. \u0110\u1EC3
      em pha cho ch\u1ECB ly n\xE0y nh\xE9; c\u1EA7m l\u1EA5y g\xF3i tr\xE0 hoa c\xFAc
      d\xE2u t\xE2y thanh l\u1ECDc c\u01A1 th\u1EC3 n\xE0y v\u1EC1 u\u1ED1ng nha,
      n\xF3 s\u1EBD gi\xFAp ch\u1ECB g\u1ED9t r\u1EEDa s\u1EA1ch s\u1EBD v\u1ECB
      \u0111\u1EAFng v\xE0 \u0111\xE1nh th\u1EE9c l\u1EA1i v\u1ECB gi\xE1c \u0111\u1EA5y."
