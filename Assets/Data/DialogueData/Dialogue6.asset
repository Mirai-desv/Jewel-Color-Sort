  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue6
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Aki
    portrait: {fileID: 8161341963055446431, guid: c8cd3b45d6f011744bbb704e11b32fba, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 0
    text: "L\u1EA1i m\u1ED9t ca tr\u1EF1c \u0111\xEAm d\xE0i..."
  - speakerName: Ichira
    portrait: {fileID: 8161341963055446431, guid: c8cd3b45d6f011744bbb704e11b32fba, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 1
    text: "Em t\u1EB7ng anh ch\xFA g\u1EA5u b\xF4ng n\xE0y \u0111\u1EC3 b\u1EA7u
      b\u1EA1n qua nh\u1EEFng \u0111\xEAm tr\u1EF1c nh\xE9."
  - speakerName: Aki
    portrait: {fileID: 8161341963055446431, guid: c8cd3b45d6f011744bbb704e11b32fba, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 0
    text: "\xD4i, c\u1EA3m \u01A1n em! C\xF3 \"c\u1EADu b\u1EA1n\" n\xE0y, ca \u0111\xEAm
      ch\u1EAFc s\u1EBD b\u1EDBt l\u1EA1nh l\u1EBDo h\u01A1n nhi\u1EC1u."
