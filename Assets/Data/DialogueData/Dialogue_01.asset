  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue_01
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "[Chu\xF4ng c\u1EEDa reo]"
  - speakerName: Fasto
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "C\u1EA7m h\u1ED9 t\xF4i \u0111\u01A1n b\xE1nh n\xE0y nh\xE9, Ichira! L\u01B0ng
      gi\xE0 c\u1EE7a t\xF4i l\u1EA1i \u0111au \xEA \u1EA9m v\xEC m\u1EA5y tr\u1EADn
      m\u01B0a d\u1EA7m d\u1EC1 d\u1EA1o n\xE0y r\u1ED3i, \u0111\xEAm n\xE0o c\u0169ng
      tr\u1EB1n tr\u1ECDc kh\xF4ng sao ng\u1EE7 \u0111\u01B0\u1EE3c."
  - speakerName: 
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "B\xE1c v\u1EA5t v\u1EA3 qu\xE1. V\xE0o \u0111\xE2y ng\u1ED3i ngh\u1EC9
      \u0111i, ch\xE1u bi\u1EBFu b\xE1c t\xFAi ch\u01B0\u1EDDm th\u1EA3o m\u1ED9c
      n\xE0y \u0111\u1EC3 ch\u01B0\u1EDDm vai bu\u1ED5i t\u1ED1i nh\xE9."
