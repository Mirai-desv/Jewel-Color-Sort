MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue11
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Ichira
    portrait: {fileID: 1739516631796900880, guid: bfcba3ed68d28b04381268f94174420a, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 1
    text: "L\u1EA1i lo chuy\u1EC7n tr\u1EA1m c\u1EE9u tr\u1EE3 \xE0, Lana?"
  - speakerName: Lana
    portrait: {fileID: 1739516631796900880, guid: bfcba3ed68d28b04381268f94174420a, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 0
    text: "Tr\u1EA1m s\u1EAFp ph\u1EA3i \u0111\xF3ng c\u1EEDa v\xEC c\u1EA1n kinh
      ph\xED r\u1ED3i Ichira \u01A1i, th\u1EE9c \u0103n cho b\u1ECDn nh\u1ECF c\u0169ng
      h\u1EBFt s\u1EA1ch lu\xF4n... M\xECnh th\u01B0\u01A1ng t\u1EE5i n\xF3 l\u1EAFm."
  - speakerName: Ichira
    portrait: {fileID: 1739516631796900880, guid: bfcba3ed68d28b04381268f94174420a, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 1
    text: "\u0110\u1EEBng n\u1EA3n l\xF2ng, m\u1ECDi ng\u01B0\u1EDDi s\u1EBD c\xF9ng
      chung tay gi\xFAp c\u1EADu m\xE0. Tr\u01B0\u1EDBc m\u1EAFt c\u1EA7m m\xF3n
      n\xE0y v\u1EC1 tr\u01B0\u1EDBc nh\xE9. (\u0110\u01B0a 3 b\u1ECBch \u0111\u1ED3
      \u0103n)"
  - speakerName: Lana
    portrait: {fileID: 1739516631796900880, guid: bfcba3ed68d28b04381268f94174420a, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 0
    text: "3 b\u1ECBch \u0111\u1ED3 \u0103n cho \u0111\u1ED9ng v\u1EADt \u1EA1?!
      \xD4i, c\u1EA3m \u01A1n c\u1EADu nhi\u1EC1u l\u1EAFm!"
