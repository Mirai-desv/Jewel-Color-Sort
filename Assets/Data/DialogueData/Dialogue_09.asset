  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue_09
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Yoko
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "L\u1EA1i v\u1EC1 nh\xE0 khi con \u0111\xE3 ng\u1EE7... C\u1EE9 b\u01B0\u01A1n
      ch\u1EA3i t\u1ED1i ng\xE0y th\u1EBF n\xE0y, kho\u1EA3ng c\xE1ch gi\u1EEFa m\u1EB9
      con t\xF4i ng\xE0y c\xE0ng xa c\xE1ch."
  - speakerName: Ichira
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "Ch\u1ECB Yoko \u01A1i, em t\u1EB7ng ch\u1ECB khung \u1EA3nh g\u1ED7 n\xE0y
      nh\xE9. H\xE3y \u0111\u1EB7t v\xE0o \u0111\xF3 t\u1EA5m h\xECnh k\u1EF7 ni\u1EC7m
      c\u1EE7a hai m\u1EB9 con \u0111\u1EC3 lu\xF4n nh\u1EDB v\u1EC1 nhau."
  - speakerName: Yoko
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "C\u1EA3m \u01A1n em... Nh\xECn b\u1EE9c \u1EA3nh n\xE0y, ch\u1ECB s\u1EBD
      t\u1EF1 nh\u1EAFc m\xECnh d\xF9 b\u1EADn th\u1EBF n\xE0o c\u0169ng ph\u1EA3i
      d\xE0nh th\u1EDDi gian cho con."
