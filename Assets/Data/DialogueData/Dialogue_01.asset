MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue_01
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    portrait: {fileID: 0}
    background: {fileID: 0}
    text: "[Chuông cửa reo]"
  - speakerName: Fasto
    portrait: {fileID: 21300000, guid: 87b68916255671af06be2805e2853aaa, type: 3}
    background: {fileID: 0}
    text: "Cầm hộ tôi đơn bánh này nhé, Ichira! Lưng
      già của tôi lại đau ê ẩm vì mấy trận
      mưa dầm dề dạo này rồi, đêm nào cũng
      trằn trọc không sao ngủ được."
  - speakerName: Ichira
    portrait: {fileID: 21300000, guid: 87b68916255671af06be2805e2853aaa, type: 3}
    background: {fileID: 0}
    text: "Bác vất vả quá. Vào đây ngồi nghỉ
      đi, cháu biếu bác túi chườm thảo mộc
      này để chườm vai buổi tối nhé."
