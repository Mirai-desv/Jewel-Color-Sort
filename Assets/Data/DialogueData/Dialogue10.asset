--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue10
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Steve
    portrait: {fileID: 0}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "...\n[Ch\u1EA7n ch\u1EEB]"
  - speakerName: Ichira
    portrait: {fileID: 121287837493667656, guid: cd98c4c9489f49e4a8bb8f95352187f1, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "B\xE1c \u01A1i, b\xE1c c\xF3 c\u1EA7n ch\xE1u gi\xFAp \u0111\u1EE1 g\xEC
      kh\xF4ng \u1EA1 ?"
  - speakerName: Steve
    portrait: {fileID: 121287837493667656, guid: cd98c4c9489f49e4a8bb8f95352187f1, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "Tay ch\xE2n d\xEDnh \u0111\u1EA7y nh\u1EDBt th\u1EBF n\xE0y, t\xF4i ng\u1EA1i
      ch\u1EB3ng d\xE1m b\u01B0\u1EDBc v\xE0o qu\xE1n \u0103n v\u1EB7t."
  - speakerName: Ichira
    portrait: {fileID: 121287837493667656, guid: cd98c4c9489f49e4a8bb8f95352187f1, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "B\xE1c \u01A1i b\xE1c v\xE0o tho\u1EA3i m\xE1i \u0111i b\xE1c, ch\xE1u
      c\xF3 c\u1EE5c x\xE0 b\xF4ng n\xE0y gi\xFAp b\xE1c \u0111\u01B0\u1EE3c \u0111\xF3!"
  - speakerName: Steve
    portrait: {fileID: 121287837493667656, guid: cd98c4c9489f49e4a8bb8f95352187f1, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "S\u1EA1ch bong th\u1EADt n\xE0y! Gi\u1EDD th\xEC t\xF4i t\u1EF1 tin \u0111i
      \u0103n b\xE1nh c\xF9ng b\u1EA1n \u0111\u01B0\u1EE3c r\u1ED3i, c\u1EA3m \u01A1n
      ch\xE1u!"
