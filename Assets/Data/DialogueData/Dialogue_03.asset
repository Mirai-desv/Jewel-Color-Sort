  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue_03
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Ken
    portrait: {fileID: 21300000, guid: f2c1862138e26d1785971f0de743e57f, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "Ch\xE1u v\u1EEBa ho\xE0n th\xE0nh b\xE0i thi th\u1EED, nh\u01B0ng \u0111i\u1EC3m
      v\u0103n kh\xF4ng nh\u01B0 \xFD mu\u1ED1n... \xC1p l\u1EF1c t\u1EEB k\u1EF3
      thi v\xE0o c\u1EA5p 3 ng\u1ED9t ng\u1EA1t qu\xE1 c\xF4 \u01A1i."
  - speakerName: Ichira
    portrait: {fileID: 21300000, guid: f2c1862138e26d1785971f0de743e57f, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    text: "C\u1ED1 l\xEAn n\xE0o, ch\u1EB7ng \u0111\u01B0\u1EDDng d\xE0i m\u1EDBi
      ch\u1EC9 b\u1EAFt \u0111\u1EA7u th\xF4i. H\xE3y chi\u1EBFn \u0111\u1EA5u v\xEC
      t\u01B0\u01A1ng lai c\u1EE7a ch\xEDnh m\xECnh, c\xF4 tin ch\xE1u s\u1EBD l\xE0m
      \u0111\u01B0\u1EE3c!"
