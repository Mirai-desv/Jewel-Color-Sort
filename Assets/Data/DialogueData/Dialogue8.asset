  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c64463a8cfb05004786c9d008fce7188, type: 3}
  m_Name: Dialogue8
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Sashi
    portrait: {fileID: 6600273264204521602, guid: a67657768e887bc4587f1928eaa3af8f, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 0
    text: "L\u1EA1i th\xEAm m\u1EA5y b\xECnh lu\u1EADn ch\u1EEDi b\u1EDBi ngo\xE0i
      kia... Ch\xFAng c\u1EE9 b\xE1m ri\u1EBFt l\u1EA5y \u0111\u1EA7u t\xF4i. \u0110\xEAm
      n\xE0o t\xF4i c\u0169ng tr\u1EB1n tr\u1ECDc nh\xECn m\xE0n h\xECnh, s\u1EE3
      h\xE3i t\u1EEBng l\u01B0\u1EE3t t\u01B0\u01A1ng t\xE1c \u0111\u1EBFn m\u1EE9c
      ng\u1EA1t th\u1EDF..."
  - speakerName: Ichira
    portrait: {fileID: 6600273264204521602, guid: a67657768e887bc4587f1928eaa3af8f, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 1
    text: "Sashi \xE0, th\u1EBF gi\u1EDBi \u1EA3o ngo\xE0i kia \u0111\xE3 l\u1EA5y
      \u0111i c\u1EE7a c\u1EADu qu\xE1 nhi\u1EC1u n\u0103ng l\u01B0\u1EE3ng r\u1ED3i.
      C\u1EADu h\xE3y d\xF9ng chi\u1EBFc h\u1ED9p g\u1ED7 \"Offline\" n\xE0y nh\xE9
      \u2013 m\u1ED7i t\u1ED1i c\u1EA5t \u0111i\u1EC7n tho\u1EA1i v\xE0o \u0111\xE2y
      \u0111\u1EC3 cho t\xE2m tr\xED \u0111\u01B0\u1EE3c th\u1EF1c s\u1EF1 ngh\u1EC9
      ng\u01A1i."
  - speakerName: Sashi
    portrait: {fileID: 6600273264204521602, guid: a67657768e887bc4587f1928eaa3af8f, type: 3}
    background: {fileID: -4364034832326165938, guid: 390cda826d8a8984bb5117d1945f3bf2, type: 3}
    darkenPortrait: 0
    text: "C\u1EA3m \u01A1n c\u1EADu... C\xF3 l\u1EBD \u0111\xE3 \u0111\u1EBFn l\xFAc
      t\xF4i g\xE1c l\u1EA1i m\xE0n h\xECnh \u0111\u1EC3 tr\u1EDF v\u1EC1 v\u1EDBi
      cu\u1ED9c s\u1ED1ng th\u1EF1c t\u1EA1i b\xECnh y\xEAn r\u1ED3i."
